# ─────────────────────────────────────────────────────────────
# ReadLoud — premium TTS providers (all optional)
# The app is fully functional with zero keys using the browser's
# built-in Web Speech engine. Keys unlock studio-grade voices and
# the deterministic server-rendered MP3 export pipeline.
# ─────────────────────────────────────────────────────────────

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: cap characters per synthesis request (cost guardrail)
READLOUD_MAX_CHARS_PER_REQUEST=6000
